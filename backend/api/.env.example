# ============================================================
# ClaimFlow API — Environment variables
# ------------------------------------------------------------
# Copy this file to .env in the same directory and fill in real
# values. .env is gitignored and must never be committed.
# ============================================================

# Node environment: development | production | test
NODE_ENV=development

# Port the API listens on. The frontend is configured to call the backend
# at http://localhost:4000 (see frontend/.env VITE_API_BASE_URL), so keep
# this as 4000 unless you also change the frontend's base URL.
PORT=4000

# ----- Secrets (REQUIRED, no fallbacks) ---------------------

# JWT signing key. Generate a strong random value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Never reuse across environments. Never commit.
JWT_SECRET=replace-with-strong-random-secret

# Token expiry — supports vercel/ms format ("15m", "12h", "7d")
JWT_EXPIRES_IN=1d

# PostgreSQL connection string. URL-encode any special chars in the password.
# Example:  postgresql://user:URL_ENCODED_PW@host:5432/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/claimflow?sslmode=require

# ----- CORS allowlist ---------------------------------------

# Comma-separated origins allowed to call this API.
# Include the Vite dev server (port 3000 for this project) and your
# deployed frontend hostname(s).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ----- Optional integrations --------------------------------

# HitPay payment gateway (only required if disbursement integration is wired up)
HITPAY_API_KEY=
HITPAY_SALT=

# Azure AI Document Intelligence (formerly Form Recognizer)
# Used by POST /api/claims/parse-receipt. If either is missing the service
# falls back to a deterministic mock parser useful for offline dev/demo.
AZURE_DOC_INTEL_ENDPOINT=
AZURE_DOC_INTEL_KEY=

# Azure Blob Storage — receipt image archive.
# Connection string from Storage Account > Access keys. Container must exist.
# If either is missing, uploads are skipped and Claim.receiptUrl stays null.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=receipts
