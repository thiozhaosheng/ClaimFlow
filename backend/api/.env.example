# ============================================================
# ClaimFlow API — Environment variables
# ------------------------------------------------------------
# Copy this file to .env in the same directory and fill in real
# values. .env is gitignored and must never be committed.
# ============================================================

# Node environment: development | production | test
NODE_ENV=development

# Port the API listens on. The frontend never calls this service directly —
# it only ever talks to auth-gateway (see backend/auth-gateway/.env.example),
# which proxies through to this port via BASE_SERVICE_PORT. Pick anything
# free; just keep this value and auth-gateway's BASE_SERVICE_PORT in sync.
PORT=3000

# ----- Secrets (REQUIRED, no fallbacks) ---------------------

# JWT signing key. Generate a strong random value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Never reuse across environments. Never commit.
JWT_SECRET=replace-with-strong-random-secret

# Token expiry — supports vercel/ms format ("15m", "12h", "7d")
JWT_EXPIRES_IN=1d

# PostgreSQL connection string. URL-encode any special chars in the password.
# Example:  postgresql://user:URL_ENCODED_PW@host:5432/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/claimflow?sslmode=require

# ----- CORS allowlist ---------------------------------------

# Comma-separated origins allowed to call this API directly. In practice
# only auth-gateway calls this service, and that's a server-to-server call
# (not subject to browser CORS), so this mostly matters if something ever
# calls backend/api directly from a browser. Set for local dev; in
# production, include the deployed frontend origin:
#   CORS_ORIGINS=https://claimflow.dev,https://www.claimflow.dev
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ----- Optional integrations --------------------------------

# HitPay payment gateway (only required if disbursement integration is wired up)
HITPAY_API_KEY=
HITPAY_SALT=

# Azure AI Document Intelligence (formerly Form Recognizer)
# Used by POST /api/claims/parse-receipt. If either is missing, or Azure
# fails/times out on a given receipt, the endpoint returns source:
# 'unavailable' with all fields null — no mock/fake data is ever returned.
# The frontend shows this as a clear error and falls back to manual entry.
AZURE_DOC_INTEL_ENDPOINT=
AZURE_DOC_INTEL_KEY=

# Azure Blob Storage — receipt image archive.
# Connection string from Storage Account > Access keys. Container must exist.
# If either is missing, uploads are skipped and Claim.receiptUrl stays null.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=receipts
