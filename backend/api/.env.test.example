# ============================================================
# ClaimFlow API - test environment
# ------------------------------------------------------------
# Copy to .env.test in this directory. .env.test is gitignored.
#
#   cp .env.test.example .env.test
#
# Loaded by jest.env.ts (setupFiles), which runs before any test
# imports application code. Values set here take precedence over
# the .env that src/config/constants.ts loads.
# ============================================================

NODE_ENV=test

# ----- Integration test opt-in ------------------------------

# Setting this switches the integration suites on. Leave it unset
# and every *.integration.test.ts skips, so `npx jest` stays green
# on a machine with no Postgres.
#
# MUST point at a throwaway database. The integration suites
# truncate Notification, AuditLog and Claim between test cases.
# Never point this at your development database.
#
# Create one with:
#   createdb claimflow_test
#   DATABASE_URL_TEST=... npx prisma db push
#   DATABASE_URL_TEST=... npx ts-node prisma/seed.ts
#
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/claimflow_test

# ----- Secrets ----------------------------------------------

# Any fixed value works: the suites sign tokens and verify them with
# this same secret. It never leaves the test process. jest.env.ts
# supplies a default if this is omitted.
JWT_SECRET=test-only-jwt-secret-do-not-use-outside-jest
JWT_EXPIRES_IN=1d

# ----- Optional: live Azure OCR ------------------------------

# The receipt parsing suite mocks services/receiptParser by default so
# tests do not depend on the network or consume Azure quota. Set both
# of these AND LIVE_OCR=1 to additionally run the one test that calls
# Azure Document Intelligence for real.
LIVE_OCR=0
AZURE_DOC_INTEL_ENDPOINT=
AZURE_DOC_INTEL_KEY=
