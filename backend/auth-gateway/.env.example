# ============================================================
# ClaimFlow Auth Gateway — Environment variables
# ------------------------------------------------------------
# Copy this file to .env in the same directory and fill in real
# values. .env is gitignored and must never be committed.
# ============================================================

NODE_ENV=development
PORT=3001

# ----- Secrets (REQUIRED) -----------------------------------

# Must be the SAME value as backend/api/.env JWT_SECRET so tokens
# minted by either service validate against the other.
JWT_SECRET=replace-with-strong-random-secret

# ----- Upstream service (proxied calls go here) -------------

BASE_SERVICE_HOST=claimflow-base.azurewebsites.net
BASE_SERVICE_PORT=3000
BASE_SERVICE_TIMEOUT=5000

# ----- CORS allowlist ---------------------------------------

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ----- Optional --------------------------------------------

STATIC_FOLDER=test
