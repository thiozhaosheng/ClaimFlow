# ============================================================
# ClaimFlow Auth Gateway — Environment variables
# ------------------------------------------------------------
# Copy this file to .env in the same directory and fill in real
# values. .env is gitignored and must never be committed.
# ============================================================

NODE_ENV=development
# 4000 matches the frontend's built-in default (NEXT_PUBLIC_API_URL falls
# back to http://localhost:4000/api) — this gateway is the only service the
# frontend ever calls directly, so keep this in sync with the frontend's
# NEXT_PUBLIC_API_URL if you change it.
PORT=4000

# ----- Secrets (REQUIRED) -----------------------------------

# Must be the SAME value as backend/api/.env JWT_SECRET so tokens
# minted by either service validate against the other.
JWT_SECRET=replace-with-strong-random-secret

# ----- Upstream service (proxied calls go here) -------------

BASE_SERVICE_HOST=claimflow-base.azurewebsites.net
BASE_SERVICE_PORT=3000
BASE_SERVICE_TIMEOUT=5000

# ----- CORS allowlist ---------------------------------------

# This is the CORS check that actually matters — the frontend calls this
# gateway from the browser. In production, this must include the deployed
# frontend origin:
#   CORS_ORIGINS=https://claimflow.dev,https://www.claimflow.dev
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ----- Optional --------------------------------------------

STATIC_FOLDER=test
