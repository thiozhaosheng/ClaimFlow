# ============================================================
# ClaimFlow Auth Gateway — Environment variables
# ------------------------------------------------------------
# Copy this file to .env in the same directory and fill in real
# values. .env is gitignored and must never be committed.
# ============================================================

NODE_ENV=development
PORT=3001

# ----- Upstream service (proxied calls go here) -------------

# Local Docker Compose overrides these with http://api:4000.
# In Azure production use: https, api.claimflow.dev, 443.
BASE_SERVICE_PROTOCOL=http
BASE_SERVICE_HOST=localhost
BASE_SERVICE_PORT=4000
BASE_SERVICE_TIMEOUT=120000

# ----- CORS allowlist ---------------------------------------

# In Azure production use: https://claimflow.dev
CORS_ORIGINS=http://localhost:3004,http://localhost:8080

# ----- Optional --------------------------------------------

STATIC_FOLDER=test
