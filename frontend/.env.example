# ============================================================
# ClaimFlow Frontend — Environment variables
# ------------------------------------------------------------
# Copy this file to .env in the same directory and adjust if
# your backend runs on a different host or port.
# Anything starting with VITE_ is bundled into the client.
# Do NOT put secrets here — these values ship to the browser.
# ============================================================

# Base URL of the ClaimFlow API (no trailing slash)
# This is the AUTH GATEWAY's port (4000), not the Claims API's (3000). The
# gateway is the only service the frontend ever calls; it proxies onward to the
# API. Pointing this at 3000 reaches the API directly, bypassing the gateway,
# and every auth call fails.
VITE_API_BASE_URL=http://localhost:4000
