# ============================================================
# ClaimFlow Frontend — Environment variables
# ------------------------------------------------------------
# Copy this file to .env in the same directory and adjust if
# your backend runs on a different host or port.
# Anything starting with VITE_ is bundled into the client.
# Do NOT put secrets here — these values ship to the browser.
# ============================================================

# Base URL of the ClaimFlow edge API (no trailing slash).
# For Azure production builds, set: https://auth.claimflow.dev
VITE_API_BASE_URL=http://localhost:3001
VITE_MOCK_API=false
