{
  "Transport": {
    "label": "Transport",
    "fields": [
      {
        "key": "fromLocation",
        "label": "From",
        "type": "text",
        "required": true,
        "placeholder": "e.g., Office (Toa Payoh)"
      },
      {
        "key": "toLocation",
        "label": "To",
        "type": "text",
        "required": true,
        "placeholder": "e.g., Client (Marina Bay)"
      },
      {
        "key": "tripPurpose",
        "label": "Trip purpose",
        "type": "select",
        "required": true,
        "options": [
          "Client meeting",
          "Off-site work",
          "Late OT return",
          "Site inspection",
          "Airport pickup/drop-off",
          "Inter-office shuttle",
          "Other"
        ]
      },
      {
        "key": "travelWindow",
        "label": "Time of trip",
        "type": "select",
        "required": true,
        "options": [
          "Morning (06-12)",
          "Afternoon (12-18)",
          "Evening (18-22)",
          "Late night (22-06)"
        ],
        "help": "Late-night transport over S$25 is flagged for review."
      }
    ]
  },
  "Meal": {
    "label": "Meal",
    "fields": [
      {
        "key": "occasion",
        "label": "Occasion",
        "type": "select",
        "required": true,
        "options": [
          "Solo working meal",
          "Team meal",
          "Working lunch with client",
          "OT dinner (after 20:00)",
          "Project celebration"
        ]
      },
      {
        "key": "attendees",
        "label": "Total attendees (incl. you)",
        "type": "number",
        "required": true,
        "min": 1,
        "max": 50
      },
      {
        "key": "attendeeNotes",
        "label": "Who attended",
        "type": "text",
        "placeholder": "e.g., 3 internal + 2 from Acme",
        "help": "Required when claim is over S$50."
      }
    ]
  },
  "Client Entertainment": {
    "label": "Client Entertainment",
    "fields": [
      {
        "key": "clientCompany",
        "label": "Client company",
        "type": "text",
        "required": true,
        "placeholder": "e.g., Acme Pte Ltd"
      },
      {
        "key": "clientContacts",
        "label": "Client contacts present",
        "type": "text",
        "required": true,
        "placeholder": "e.g., Jane Lim, Marcus Wee",
        "help": "Named contacts required by IRAS for entertainment records."
      },
      {
        "key": "internalCount",
        "label": "Internal attendees",
        "type": "number",
        "required": true,
        "min": 1,
        "max": 50
      },
      {
        "key": "externalCount",
        "label": "Client attendees",
        "type": "number",
        "required": true,
        "min": 1,
        "max": 50
      },
      {
        "key": "businessJustification",
        "label": "Business justification",
        "type": "textarea",
        "required": true,
        "placeholder": "What was discussed, outcome expected, deal value if relevant.",
        "help": "IRAS requires a clear business purpose for entertainment expenses."
      },
      {
        "key": "gstRegNumber",
        "label": "Supplier GST reg no.",
        "type": "text",
        "placeholder": "e.g., 198703169W",
        "help": "Required for full tax invoice claims above S$1,000."
      }
    ]
  },
  "Office Supplies": {
    "label": "Office Supplies",
    "fields": [
      {
        "key": "itemSummary",
        "label": "Items purchased",
        "type": "textarea",
        "required": true,
        "placeholder": "Brief list, e.g., 5 reams A4 paper, USB-C hub, sticky notes."
      },
      {
        "key": "forTeam",
        "label": "Intended team (optional)",
        "type": "text",
        "placeholder": "e.g., Engineering"
      }
    ]
  },
  "Travel": {
    "label": "Overseas travel",
    "fields": [
      {
        "key": "destination",
        "label": "Destination",
        "type": "text",
        "required": true,
        "placeholder": "City, country"
      },
      {
        "key": "departureDate",
        "label": "Departure",
        "type": "date",
        "required": true
      },
      {
        "key": "returnDate",
        "label": "Return",
        "type": "date",
        "required": true
      },
      {
        "key": "tripPurpose",
        "label": "Trip purpose",
        "type": "textarea",
        "required": true,
        "placeholder": "Conference / client visit / vendor audit etc., plus outcome expected."
      },
      {
        "key": "mode",
        "label": "Mode",
        "type": "select",
        "required": true,
        "options": ["Flight", "Train", "Sea", "Mixed"]
      }
    ]
  },
  "Training": {
    "label": "Training",
    "fields": [
      {
        "key": "courseName",
        "label": "Course name",
        "type": "text",
        "required": true,
        "placeholder": "e.g., AWS Solutions Architect Associate"
      },
      {
        "key": "provider",
        "label": "Training provider",
        "type": "text",
        "required": true,
        "placeholder": "e.g., AWS Training, Coursera, NUS ISS"
      },
      {
        "key": "startDate",
        "label": "Course starts",
        "type": "date",
        "required": true
      },
      {
        "key": "endDate",
        "label": "Course ends",
        "type": "date",
        "required": true
      },
      {
        "key": "businessJustification",
        "label": "How it helps your work",
        "type": "textarea",
        "required": true,
        "placeholder": "Skills you'll gain and how you'll apply them.",
        "help": "Required for all training claims. Used for IRAS deductibility check."
      }
    ]
  },
  "Medical (statutory)": {
    "label": "Medical — statutory",
    "fields": [
      {
        "key": "clinic",
        "label": "Clinic / hospital",
        "type": "text",
        "required": true,
        "placeholder": "e.g., Raffles Medical Tampines"
      },
      {
        "key": "treatmentType",
        "label": "Treatment type",
        "type": "select",
        "required": true,
        "options": [
          "Pre-employment medical",
          "Statutory annual check-up",
          "WICA-covered work injury",
          "Other statutory medical"
        ]
      },
      {
        "key": "referenceCase",
        "label": "Case / claim ref",
        "type": "text",
        "placeholder": "WICA case no. or MOM ref if applicable"
      }
    ]
  },
  "Medical (non-statutory)": { "label": "Medical — non-statutory", "fields": [] },
  "Club Subscription": { "label": "Club Subscription", "fields": [] },
  "Family Benefit": { "label": "Family Benefit", "fields": [] },
  "Motor Car (non-commercial)": { "label": "Motor Car — non-commercial", "fields": [] }
}
